{
  "name": "common_get_file_metadata",
  "description": "在授权范围内读取文件元数据；不返回文件原始内容",
  "method": "GET",
  "path": "/api/v1/files/{id}",
  "permission": "file:read",
  "idempotencyRequired": false,
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "读取文件元数据参数",
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "additionalProperties": false
  }
}
