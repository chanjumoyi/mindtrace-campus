{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "创建通用任务参数",
  "type": "object",
  "required": ["moduleCode", "taskType", "title"],
  "properties": {
    "moduleCode": {"type": "string", "pattern": "^[A-Z0-9_-]{2,50}$"},
    "taskType": {"type": "string", "minLength": 2, "maxLength": 80},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "requestRef": {"type": ["string", "null"], "maxLength": 200}
  },
  "additionalProperties": false
}
