{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "统一AI网关调用参数",
  "type": "object",
  "required": ["moduleCode", "operation", "input"],
  "properties": {
    "moduleCode": {"type": "string", "pattern": "^[A-Z0-9_-]{2,50}$"},
    "operation": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{2,100}$"},
    "input": {"type": "object"},
    "timeoutMs": {"type": "integer", "minimum": 200, "maximum": 30000}
  },
  "additionalProperties": false
}
