{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "save_sandbox_record",
  "description": "保存沙盘记录——将用户在Canvas上完成的沙盘布局保存到数据库",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "save_sandbox_record",
      "description": "工具名称"
    },
    "description": {
      "type": "string",
      "description": "工具用途说明",
      "default": "保存用户的沙盘布局记录，包含所有元素的坐标和属性。幂等：相同idempotencyKey的重复调用返回相同结果。"
    },
    "parameters": {
      "type": "object",
      "required": ["sessionId", "elements", "idempotencyKey"],
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "会话ID"
        },
        "elements": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["instanceId", "elementId", "category", "x", "y"],
            "properties": {
              "instanceId": { "type": "string" },
              "elementId": { "type": "string" },
              "category": {
                "type": "string",
                "enum": ["人物", "动物", "建筑", "植物", "自然", "交通工具", "抽象符号"]
              },
              "x": { "type": "number", "minimum": 0, "maximum": 800 },
              "y": { "type": "number", "minimum": 0, "maximum": 600 },
              "rotation": { "type": "number", "minimum": 0, "maximum": 360, "default": 0 },
              "scale": { "type": "number", "minimum": 0.2, "maximum": 3.0, "default": 1.0 },
              "zIndex": { "type": "integer", "minimum": 0, "maximum": 999, "default": 0 }
            }
          }
        },
        "userDescription": {
          "type": "string",
          "maxLength": 500,
          "description": "用户对沙盘作品的文字描述（可选）"
        },
        "idempotencyKey": {
          "type": "string",
          "description": "幂等键：sessionId + timestamp的哈希"
        }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "recordId": { "type": "string", "description": "保存的记录ID" },
      "status": { "type": "string", "enum": ["saved", "cached"] },
      "elementCount": { "type": "integer" }
    }
  },
  "permission": {
    "level": "write",
    "scope": "own-records",
    "description": "仅可保存当前用户自己的沙盘记录"
  },
  "reliability": {
    "timeout": 5000,
    "maxRetries": 3,
    "retryStrategy": "exponential-backoff",
    "idempotencyKeyField": "idempotencyKey"
  },
  "errorFallback": {
    "timeout": "保存超时，请稍后重试。如多次失败，可先截图保存当前沙盘。",
    "validationError": "数据格式有误，请刷新页面后重试。",
    "serverError": "保存失败，沙盘数据暂未丢失，可重新提交。"
  }
}
