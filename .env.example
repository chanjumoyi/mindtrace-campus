APP_ENV=development
MYSQL_DATABASE=mindline
MYSQL_USER=mindline
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
DATABASE_URL=mysql+pymysql://mindline:change_me@localhost:3306/mindline?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# AI 陪伴对话。LLM_MODE=mock 时完全离线、不需要任何密钥，适合功能测试和验收。
# 需要真实模型时改为 LLM_MODE=llm，并填入自己的 DEEPSEEK_API_KEY；缺密钥会自动降级为 mock。
LLM_MODE=mock
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3

# 笔迹分析的解释层（可选）。默认 mock，不调用外部模型。
HANDWRITING_LLM_MODE=mock
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen2.5-7b-instruct
QWEN_TIMEOUT_SECONDS=20
QWEN_MAX_ATTEMPTS=3
