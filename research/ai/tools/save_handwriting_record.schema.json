{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "save_handwriting_record",
  "description": "保存笔迹行为观察记录——保存本次轨迹的分析结果引用与用户自评，不保存诊断结论",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "save_handwriting_record"
    },
    "parameters": {
      "type": "object",
      "required": ["sessionId", "requestId", "idempotencyKey"],
      "properties": {
        "sessionId": { "type": "string" },
        "requestId": {
          "type": "string",
          "description": "笔迹分析接口返回的 requestId，用于关联客观特征结果"
        },
        "selfStressLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "selfMoodLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "selfSleepQuality": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "note": { "type": ["string", "null"], "maxLength": 1000 },
        "idempotencyKey": { "type": "string" }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "recordId": { "type": "string" },
      "status": { "type": "string", "enum": ["saved", "cached"] }
    }
  },
  "permission": {
    "level": "write",
    "scope": "own-records"
  },
  "reliability": {
    "timeout": 5000,
    "maxRetries": 3,
    "retryStrategy": "exponential-backoff",
    "idempotencyKeyField": "idempotencyKey"
  },
  "errorFallback": {
    "timeout": "保存超时，请稍后重试。",
    "validationError": "记录数据不完整，请检查必填项。",
    "serverError": "保存失败，请稍后重试。"
  }
}
