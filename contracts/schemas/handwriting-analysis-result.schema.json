{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindline.example/schemas/handwriting-analysis-result.schema.json",
  "title": "MindLine handwriting analysis result",
  "type": "object",
  "required": ["requestId", "status", "writingContent", "dataQuality", "observations", "stateScores", "confidence", "limitations", "modelVersion"],
  "properties": {
    "requestId": { "type": "string" },
    "status": { "enum": ["SUCCESS", "INSUFFICIENT_DATA", "FAILED"] },
    "writingContent": {
      "type": "string",
      "description": "The task text shown to the writer. This is trace metadata, not OCR output."
    },
    "dataQuality": { "type": "number", "minimum": 0, "maximum": 1 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "description", "change"],
        "properties": {
          "feature": { "type": "string" },
          "description": { "type": "string" },
          "change": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      }
    },
    "stateScores": {
      "type": "object",
      "required": ["hesitation", "rhythmInstability", "writingTension"],
      "properties": {
        "hesitation": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "rhythmInstability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "writingTension": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "experimentalPrediction": {
      "type": "object",
      "required": ["status", "confidenceLevel", "modelVersion", "scores", "warning"],
      "properties": {
        "status": { "enum": ["EXPERIMENTAL", "UNAVAILABLE"] },
        "confidenceLevel": { "enum": ["LOW", "NONE"] },
        "modelVersion": { "type": ["string", "null"] },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "participantCount": { "type": "integer", "minimum": 0 },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "minimum": 1, "maximum": 5 }
            },
            "additionalProperties": false
          }
        },
        "warning": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "modelVersion": { "type": "string" },
    "features": {
      "type": "object",
      "description": "Interpretable feature extraction result; fields evolve with featureVersion."
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesisId", "sourceTitle", "pdfPage", "usage"],
        "properties": {
          "hypothesisId": { "type": "string" },
          "sourceTitle": { "type": "string" },
          "pdfPage": { "type": "string" },
          "usage": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "llmExplanation": {
      "type": "object",
      "required": ["status", "provider", "model", "summary", "explorationQuestions", "disclaimer"],
      "properties": {
        "status": { "enum": ["SUCCESS", "MOCK", "DEGRADED"] },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "summary": { "type": "string" },
        "explorationQuestions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "disclaimer": { "type": "string" },
        "degradationNote": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
