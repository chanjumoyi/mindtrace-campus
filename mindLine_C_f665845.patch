new file mode 100644
index 0000000..4178a9d
--- /dev/null
+++ b/kingdee/tools/build_c_assets.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Build deterministic, C-only Kingdee import worksheets and Agent tool registration files."""
+from __future__ import annotations
+import csv, hashlib, json, pathlib, sys
+import yaml
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+DOMAIN_SOURCE = ROOT / "kingdee/domain-models/common-foundation-models.yaml"
+TOOL_SOURCE = ROOT / "kingdee/agent-tools/tool-registration.yaml"
+DOMAIN_OUT = ROOT / "kingdee/domain-models/generated"
+TOOL_OUT = ROOT / "kingdee/agent-tools/generated"
+
+def dump_json(path: pathlib.Path, data: object) -> None:
+    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+def sha256(path: pathlib.Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def main() -> int:
+    domain = yaml.safe_load(DOMAIN_SOURCE.read_text(encoding="utf-8"))
+    if domain.get("owner") != "C": raise SystemExit("domain source must be owned by C")
+    models = domain.get("models") or []
+    codes = [m["code"] for m in models]
+    if len(codes) != len(set(codes)): raise SystemExit("duplicate model code")
+    DOMAIN_OUT.mkdir(parents=True, exist_ok=True)
+    TOOL_OUT.mkdir(parents=True, exist_ok=True)
+    for stale in DOMAIN_OUT.glob("*"):
+        if stale.is_file(): stale.unlink()
+    for stale in TOOL_OUT.glob("*.registration.json"):
+        stale.unlink()
+    dump_json(DOMAIN_OUT / "common-foundation-models.import.json", domain)
+    with (DOMAIN_OUT / "model-fields.import.csv").open("w", encoding="utf-8-sig", newline="") as f:
+        w = csv.writer(f, lineterminator="\n")
+        w.writerow(["model_code","model_name","source_table","field_code","field_type","length","required","unique","enum_values","data_level","owner"])
+        for model in models:
+            for field in model.get("fields", []):
+                w.writerow([model["code"], model["name"], model.get("sourceTable", ""), field["code"], field["type"],
+                            field.get("length", ""), field.get("required", False), field.get("unique", False),
+                            "|".join(str(x) for x in field.get("values", [])), model.get("dataLevel", ""), "C"])
+    with (DOMAIN_OUT / "role-permissions.import.csv").open("w", encoding="utf-8-sig", newline="") as f:
+        w = csv.writer(f, lineterminator="\n"); w.writerow(["model_code","role_code","permission"])
+        for model in models:
+            for role, permissions in (model.get("permissions") or {}).items():
+                for permission in permissions: w.writerow([model["code"], role, permission])
+
+    tools = yaml.safe_load(TOOL_SOURCE.read_text(encoding="utf-8"))
+    c_tools = [t for t in tools.get("tools", []) if t.get("owner") == "C"]
+    for tool in c_tools:
+        schema_path = ROOT / tool["schemaFile"]
+        schema = json.loads(schema_path.read_text(encoding="utf-8"))
+        dump_json(TOOL_OUT / (tool["name"] + ".registration.json"), {
+            "name": tool["name"], "description": tool["purpose"], "method": tool["method"],
+            "path": tool["path"], "permission": tool["permission"], "idempotencyRequired": tool.get("idempotencyRequired", False),
+            "inputSchema": schema,
+        })
+    schema_paths = sorted(ROOT / t["schemaFile"] for t in c_tools)
+    manifest_paths = [DOMAIN_SOURCE, DOMAIN_OUT / "common-foundation-models.import.json", DOMAIN_OUT / "model-fields.import.csv",
+                      DOMAIN_OUT / "role-permissions.import.csv", TOOL_SOURCE] + schema_paths + sorted(TOOL_OUT.glob("*.json"))
+    manifest = {str(p.relative_to(ROOT)): sha256(p) for p in manifest_paths}
+    dump_json(ROOT / "kingdee/generated-assets-manifest.json", manifest)
+    print(f"Built {len(models)} C models and {len(c_tools)} C Agent tools")
+    return 0
+
+if __name__ == "__main__": sys.exit(main())
diff --git a/local/backend/src/main/java/com/xinji/foundation/ai/AgentHttpClient.java b/local/backend/src/main/java/com/xinji/foundation/ai/AgentHttpClient.java
new file mode 100644
index 0000000..6506492
--- /dev/null
+++ b/local/backend/src/main/java/com/xinji/foundation/ai/AgentHttpClient.java
@@ -0,0 +1,143 @@
+package com.xinji.foundation.ai;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.xinji.foundation.config.XinjiProperties;
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.Flow;
+import org.springframework.stereotype.Component;
+
+@Component
+public class AgentHttpClient {
+    private static final TypeReference<Map<String, Object>> MAP_TYPE = new TypeReference<>() {};
+
+    private final HttpClient client;
+    private final ObjectMapper mapper;
+    private final XinjiProperties properties;
+    private final URI invokeUri;
+
+    public AgentHttpClient(HttpClient agentHttpClient, ObjectMapper mapper, XinjiProperties properties) {
+        this.client = agentHttpClient;
+        this.mapper = mapper;
+        this.properties = properties;
+        String base = properties.getAgent().getBaseUrl();
+        if (base == null || base.isBlank()) throw new IllegalArgumentException("xinji.agent.base-url is required");
+        this.invokeUri = URI.create(base.endsWith("/") ? base + "v1/invoke" : base + "/v1/invoke");
+        String scheme = invokeUri.getScheme();
+        if (!"http".equalsIgnoreCase(scheme) && !"https".equalsIgnoreCase(scheme)) {
+            throw new IllegalArgumentException("xinji.agent.base-url must use http or https");
+        }
+    }
+
+    public TransportResponse invoke(Map<String, Object> outbound, int timeoutMs, String requestId, String idempotencyKey)
+            throws IOException, InterruptedException {
+        byte[] requestBody = mapper.writeValueAsBytes(outbound);
+        HttpRequest request = HttpRequest.newBuilder(invokeUri)
+                .timeout(Duration.ofMillis(Math.max(1, timeoutMs)))
+                .header("Content-Type", "application/json")
+                .header("Accept", "application/json")
+                .header("X-Request-Id", requestId)
+                .header("Idempotency-Key", idempotencyKey)
+                .POST(HttpRequest.BodyPublishers.ofByteArray(requestBody))
+                .build();
+
+        HttpResponse<byte[]> response = client.send(request, limitedBodyHandler(properties.getAgent().getMaxResponseBytes()));
+        byte[] bytes = response.body() == null ? new byte[0] : response.body();
+        String rawBody = new String(bytes, StandardCharsets.UTF_8);
+        Map<String, Object> body = Map.of();
+        if (response.statusCode() >= 200 && response.statusCode() < 300) {
+            if (rawBody.isBlank()) throw new AgentProtocolException("Agent returned an empty success response");
+            try {
+                body = mapper.readValue(rawBody, MAP_TYPE);
+            } catch (IOException ex) {
+                throw new AgentProtocolException("Agent returned invalid JSON", ex);
+            }
+        }
+        return new TransportResponse(response.statusCode(), body, safeBody(rawBody), parseRetryAfterMs(response));
+    }
+
+
+    private static HttpResponse.BodyHandler<byte[]> limitedBodyHandler(int limit) {
+        return ignored -> new LimitedBodySubscriber(limit);
+    }
+
+    private static final class LimitedBodySubscriber implements HttpResponse.BodySubscriber<byte[]> {
+        private final HttpResponse.BodySubscriber<byte[]> delegate = HttpResponse.BodySubscribers.ofByteArray();
+        private final int limit;
+        private Flow.Subscription subscription;
+        private int received;
+        private boolean terminated;
+
+        private LimitedBodySubscriber(int limit) { this.limit = limit; }
+        @Override public CompletionStage<byte[]> getBody() { return delegate.getBody(); }
+        @Override public void onSubscribe(Flow.Subscription subscription) {
+            this.subscription = subscription;
+            delegate.onSubscribe(subscription);
+        }
+        @Override public void onNext(List<ByteBuffer> items) {
+            if (terminated) return;
+            long chunk = 0;
+            for (ByteBuffer item : items) chunk += item.remaining();
+            if ((long) received + chunk > limit) {
+                terminated = true;
+                subscription.cancel();
+                delegate.onError(new AgentProtocolException("Agent response exceeds configured maximum size"));
+                return;
+            }
+            received += (int) chunk;
+            delegate.onNext(items);
+        }
+        @Override public void onError(Throwable throwable) {
+            if (terminated) return;
+            terminated = true;
+            delegate.onError(throwable);
+        }
+        @Override public void onComplete() {
+            if (terminated) return;
+            terminated = true;
+            delegate.onComplete();
+        }
+    }
+
+    private static Long parseRetryAfterMs(HttpResponse<?> response) {
+        String value = response.headers().firstValue("Retry-After").orElse(null);
+        if (value == null || value.isBlank()) return null;
+        try {
+            long seconds = Long.parseLong(value.trim());
+            return Math.max(0, seconds * 1000);
+        } catch (NumberFormatException ignored) {
+            try {
+                ZonedDateTime at = ZonedDateTime.parse(value.trim(), DateTimeFormatter.RFC_1123_DATE_TIME);
+                return Math.max(0, Duration.between(ZonedDateTime.now(at.getZone()), at).toMillis());
+            } catch (DateTimeParseException ignoredAgain) {
+                return null;
+            }
+        }
+    }
+
+    private static String safeBody(String value) {
+        if (value == null) return null;
+        String sanitized = value.replaceAll("(?i)(token|secret|password|authorization)(\\s*[:=]\\s*)[^,}\\s]+", "$1$2***");
+        return sanitized.substring(0, Math.min(500, sanitized.length()));
+    }
+
+    public record TransportResponse(int statusCode, Map<String, Object> body, String safeBody, Long retryAfterMs) {}
+
+    public static class AgentProtocolException extends IOException {
+        public AgentProtocolException(String message) { super(message); }
+        public AgentProtocolException(String message, Throwable cause) { super(message, cause); }
+    }
+}
